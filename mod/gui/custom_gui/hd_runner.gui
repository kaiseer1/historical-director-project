# Historical Director - execution pump, and the log-clear executor.
#
# A 1x1 window parked in a corner that recreates itself on a timer. Each time
# it is created it runs the orchestrator's staged effect file. This is the only
# way a mod can execute script an external program decided on: `run` is a
# console command, and ExecuteConsoleCommand is a GUI function, so a widget has
# to be the thing that calls it. Requires -debug_mode, as VOTC does.
#
# Recreation is deliberately unconditional. An earlier version gated it on
# whether a VOTC conversation was open, to keep the two mods off the console at
# once. That was wrong: a gated recreation state does not pause the pump, it
# lets the widget expire without a successor, so the first VOTC conversation of
# a session killed the pump permanently. Running the file concurrently is
# harmless anyway, because every batch carries a token guard and re-running a
# completed batch does nothing.
#
# Note what recreates and what does not. `hd_runner_counter` rebuilds itself
# every two seconds; the window around it does not, and neither do the log
# clear slots below. That is the point of putting them here: they need to
# outlive a single tick to see a request arrive, and they are resurrected along
# with the window by the re-arm network whenever a fullscreen event kills it.

window = {
	name = "hd_runner"
	size = { 1% 1% }
	parentanchor = top|right
	movable = no
	layer = bottom_bottom

	state = {
		name = itsshowtime
		trigger_on_create = yes
	}

	hbox = {
		name = "hd_runner_counter"

		state = {
			name = _show
			trigger_on_create = yes
			on_finish = "[ExecuteConsoleCommand('run hd.txt')]"
		}

		state = {
			name = _show2
			trigger_on_create = yes
			duration = 2
			on_finish = "[ExecuteConsoleCommand('gui.createwidget gui/custom_gui/hd_runner.gui hd_runner_counter')]"
		}
	}

	# --- log clear slots -----------------------------------------------------
	#
	# CK3 stops logging after roughly 17MB of cumulative writes in a session,
	# and the Director is a heavy writer: one snapshot of a wide sphere is
	# thousands of lines. Truncating debug.log from outside does not help,
	# because the engine counts what it has written rather than what is still
	# on disk. `log.clearAll` resets that counter and is the only thing that
	# does. Both facts are the VOTC project's, measured rather than reasoned
	# about; see issue #1 on this repository.
	#
	# One hbox per slot, one state per hbox. Sibling states under a single
	# widget are mutually exclusive state machines in this engine and an extra
	# one can starve the others - VOTC lost two implementations to that rule
	# before finding it - so nothing here stacks a second state anywhere.
	#
	# `on_start` clears the log; `on_finish` retires the slot through the
	# scripted GUI, so the request is consumed by the thing that serviced it.
	# The orchestrator also retires the previous slot with each new request,
	# which is redundancy rather than duplication: if this widget was dead when
	# the request arrived, the slot would otherwise stand set for ever and its
	# turn in the rotation would never present a fresh edge again.

	hbox = {
		name = "hd_log_clear_a"
		state = {
			name = fire
			trigger_when = "[GetScriptedGui('hd_log_clear_a').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			on_start = "[ExecuteConsoleCommand('log.clearAll')]"
			on_finish = "[GetScriptedGui('hd_log_clear_a').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}
	}

	hbox = {
		name = "hd_log_clear_b"
		state = {
			name = fire
			trigger_when = "[GetScriptedGui('hd_log_clear_b').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			on_start = "[ExecuteConsoleCommand('log.clearAll')]"
			on_finish = "[GetScriptedGui('hd_log_clear_b').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}
	}

	hbox = {
		name = "hd_log_clear_c"
		state = {
			name = fire
			trigger_when = "[GetScriptedGui('hd_log_clear_c').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			on_start = "[ExecuteConsoleCommand('log.clearAll')]"
			on_finish = "[GetScriptedGui('hd_log_clear_c').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}
	}

	hbox = {
		name = "hd_log_clear_d"
		state = {
			name = fire
			trigger_when = "[GetScriptedGui('hd_log_clear_d').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			on_start = "[ExecuteConsoleCommand('log.clearAll')]"
			on_finish = "[GetScriptedGui('hd_log_clear_d').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}
	}
}
